{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#171513"
				},
				{
					"slug": "ink-2",
					"name": "Charcoal",
					"color": "#3b3631"
				},
				{
					"slug": "muted",
					"name": "Stone",
					"color": "#7b7369"
				},
				{
					"slug": "bg",
					"name": "Linen",
					"color": "#eeeae3"
				},
				{
					"slug": "bg-2",
					"name": "Sand",
					"color": "#e5dfd5"
				},
				{
					"slug": "paper",
					"name": "Paper",
					"color": "#f7f4ef"
				},
				{
					"slug": "cream",
					"name": "Cream",
					"color": "#f1ebe1"
				},
				{
					"slug": "dark",
					"name": "Espresso",
					"color": "#141210"
				},
				{
					"slug": "accent",
					"name": "Terracotta",
					"color": "#b4532a"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Inter Tight",
					"fontFamily": "\"Inter Tight\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter Tight",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-tight-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Inter Tight",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-tight-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "serif",
					"name": "Instrument Serif",
					"fontFamily": "\"Instrument Serif\", \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Instrument Serif",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/instrument-serif-latin-400-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Instrument Serif",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/instrument-serif-latin-ext-400-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Instrument Serif",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/instrument-serif-latin-400-italic.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Instrument Serif",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/instrument-serif-latin-ext-400-italic.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "14px",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "17px",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "24px",
					"fluid": {
						"min": "20px",
						"max": "24px"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "48px",
					"fluid": {
						"min": "34px",
						"max": "64px"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "96px",
					"fluid": {
						"min": "52px",
						"max": "120px"
					}
				}
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1280px"
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"vw",
				"vh",
				"%"
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"lineHeight": "1.55",
			"fontSize": "var(--wp--preset--font-size--medium)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "400",
					"lineHeight": "1",
					"letterSpacing": "-0.02em"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--ink)",
					"text": "var(--wp--preset--color--cream)"
				},
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontWeight": "500",
					"fontSize": "15px"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"bottom": "14px",
						"left": "26px",
						"right": "26px"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "#ffffff"
					}
				}
			}
		},
		"blocks": {
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"width": "2px",
						"style": "solid"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"core/separator": {
				"color": {
					"text": "rgba(23, 21, 19, 0.15)"
				}
			}
		}
	}
}